<Window x:Class="Kotoba.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gengo · Japanese–English dictionary" Icon="Assets/Gengo.ico" Width="1120" Height="840" MinWidth="780" MinHeight="600" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <Grid Margin="32,18,32,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="AppHeader" Margin="0,0,0,18"><TextBlock DockPanel.Dock="Right" Text="YOUR PERSONAL JAPANESE DICTIONARY" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="言語" FontFamily="Yu Gothic UI" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="  Gengo" FontSize="20" VerticalAlignment="Center"/><TextBlock Text="  げんご" FontFamily="Yu Gothic UI" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel></DockPanel>
  <TabControl x:Name="Navigation" Grid.Row="1" SelectionChanged="NavigationChanged">
   <TabItem Header="Search"><Grid x:Name="SearchWorkspace" SizeChanged="ReadingWorkspaceSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="SearchInputCard" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="184" VerticalScrollBarVisibility="Auto" FontFamily="Yu Gothic UI" FontSize="20" TextChanged="InputChanged" Margin="0,0,14,5"/>
      <DockPanel Margin="2,0,14,0"><TextBlock Text="Enter to search · Shift+Enter for a new line" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CharacterLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}"/></DockPanel></StackPanel>
     <StackPanel Grid.Column="1"><Button x:Name="SearchButton" Content="Search" Style="{StaticResource PrimaryButton}" Click="SearchClick" Margin="0,0,0,5"/><Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" IsEnabled="False" Padding="14,3" Margin="0"/></StackPanel>
    </Grid></Border>
    <Border Grid.Row="1" x:Name="SetupBanner" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Make this dictionary yours" FontSize="21" Margin="0,0,0,8"/><TextBlock Text="Install the offline dictionary and Japanese analyzer in Settings (about 62 MiB of downloads, about 500 MiB installed). After installation, searches and built-in grammar work without internet." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/><Button Content="Open resource setup" HorizontalAlignment="Left" Click="OpenSettingsClick"/></StackPanel></Border>
    <Border Grid.Row="2" x:Name="SentenceCard" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="CHOOSE A WORD" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
     <AdornerDecorator Grid.Row="1" Margin="0,12,0,0"><RichTextBox x:Name="Sentence" IsReadOnly="True" IsDocumentEnabled="True" MaxHeight="310" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="0" SelectionBrush="#557D84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><RichTextBox.ContextMenu><ContextMenu><MenuItem Header="Copy" Command="ApplicationCommands.Copy"/><MenuItem Header="Look up selection" Click="LookupSelectionClick"/><MenuItem Header="Add personal entry" Click="AddSelectionClick"/></ContextMenu></RichTextBox.ContextMenu></RichTextBox></AdornerDecorator>
     <TextBlock Grid.Row="2" x:Name="PassageLegend" Text="Nouns · verbs · particles · adjectives use different colors. Select text and right-click for a custom lookup." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
     <Button Grid.Row="3" x:Name="ExplainGrammarButton" Content="Explain grammar" HorizontalAlignment="Left" Click="GrammarClick" Padding="10,4" Margin="0,10,0,0"/>
    </Grid></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*" MinWidth="210"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Words" FontSize="23" Margin="0,0,0,10"/><ScrollViewer x:Name="WordsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="WordsHint" Text="Search a passage, then click an underlined word." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><StackPanel x:Name="DefinitionPanel"/><StackPanel x:Name="AlternativesPanel"/></StackPanel></ScrollViewer></Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Kanji" FontSize="23" Margin="0,0,0,10"/><ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="KanjiPanel"><TextBlock Text="Choose a word to see its kanji and your Anki meanings." Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel x:Name="GrammarPanel"/></StackPanel></ScrollViewer></Grid>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Personal dictionary"><Grid x:Name="PersonalWorkspace">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="220" MaxWidth="440"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="New entry" Click="NewEntryClick" Margin="12,0,0,0"/><TextBlock Text="Your entries" FontSize="23" VerticalAlignment="Center"/></DockPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,12"><RadioButton x:Name="AllPersonalFilter" Content="All" GroupName="PersonalFilter" IsChecked="True" Checked="PersonalFilterChanged" Margin="0,0,14,8"/><RadioButton x:Name="WordsPersonalFilter" Content="Personal words" GroupName="PersonalFilter" Checked="PersonalFilterChanged" Margin="0,0,14,8"/><RadioButton x:Name="NamesPersonalFilter" Content="Names" GroupName="PersonalFilter" Checked="PersonalFilterChanged" Margin="0,0,0,8"/></WrapPanel>
     <ListBox x:Name="PersonalList" Grid.Row="2" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PersonalSelected"/>
     <TextBlock Grid.Row="3" Text="Literal matches take priority in every passage. Longer expressions at the same position win." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PersonalEditor">
     <TextBlock Text="Personal entry" FontSize="23" Margin="0,0,0,18"/>
     <TextBlock Text="Category"/><WrapPanel Margin="0,6,0,14"><RadioButton x:Name="WordsCategory" Content="Personal words" GroupName="EntryCategory" IsChecked="True" Margin="0,0,20,0"/><RadioButton x:Name="NamesCategory" Content="Names" GroupName="EntryCategory"/></WrapPanel>
     <TextBlock Text="Expression *"/><TextBox x:Name="ExpressionInput" FontFamily="Yu Gothic UI" FontSize="21"/><TextBlock Text="Reading (optional)"/><TextBox x:Name="ReadingInput" FontFamily="Yu Gothic UI" FontSize="19"/>
     <TextBlock Text="English definition *"/>
     <WrapPanel Margin="0,6,0,0">
      <Button Content="B" FontWeight="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=DefinitionInput}" Focusable="False" ToolTip="Bold (Ctrl+B)" Padding="10,4"/>
      <Button Content="I" FontStyle="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=DefinitionInput}" Focusable="False" ToolTip="Italic (Ctrl+I)" Padding="10,4"/>
      <Button Content="1. List" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=DefinitionInput}" Focusable="False" Padding="10,4"/>
      <Button Content="• List" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=DefinitionInput}" Focusable="False" Padding="10,4"/>
      <Button Content="Subscript" Click="SubscriptClick" Focusable="False" Padding="10,4" ToolTip="Toggle smaller text below the baseline"/>
      <Button Content="Small note" Click="SmallNoteClick" Focusable="False" Padding="10,4" ToolTip="Toggle smaller inline usage notes, like Jisho"/>
     </WrapPanel>
     <RichTextBox x:Name="DefinitionInput" Height="175" VerticalScrollBarVisibility="Auto" Background="#141B23" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}" SelectionBrush="#476D79" Padding="10" Margin="0,0,0,10"><FlowDocument FontSize="14" PagePadding="0"><Paragraph/></FlowDocument></RichTextBox>
     <TextBlock Text="Notes (optional)"/><TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto"/><WrapPanel><Button Content="Save entry" Style="{StaticResource PrimaryButton}" Click="SaveEntryClick"/><Button Content="Delete entry" Click="DeleteEntryClick"/></WrapPanel><TextBlock x:Name="PersonalStatus" Foreground="{StaticResource AccentBrush}"/>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="Statistics &amp; history"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="The words you come back to" FontSize="23" Margin="0,0,0,8"/><TextBlock Text="Only deliberate definition openings count. Words appear after five openings within the selected dates." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
    <WrapPanel><TextBlock Text="From  " VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Width="145" Margin="0,0,15,12"/><TextBlock Text="Through  " VerticalAlignment="Center"/><DatePicker x:Name="ThroughDate" Width="145" Margin="0,0,15,12"/><Button Content="Apply dates" Click="ApplyDatesClick"/><Button Content="All history" Click="AllDatesClick"/></WrapPanel>
    <TextBlock x:Name="TotalsText" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
    <ListBox x:Name="StatisticsList" MaxHeight="260" SelectionChanged="StatisticSelected" PreviewKeyDown="StatisticKeyDown" ToolTip="Double-click a word or press Enter to revisit its definition in Search."/><TextBlock x:Name="ClickDetails" Margin="0,12,0,20"/>
    <TextBlock Text="Daily lookups" FontSize="18" Margin="0,0,0,8"/><TextBlock x:Name="DailyText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"/>
    <TextBlock Text="Submitted passages" FontSize="20" Margin="0,0,0,12"/><StackPanel x:Name="HistoryPanel"/><WrapPanel><Button Content="Previous page" Click="PreviousHistoryClick"/><Button Content="Next page" Click="NextHistoryClick"/><Button Content="Delete history in selected dates…" Click="DeleteRangeClick"/></WrapPanel>
    <TextBlock Text="Recent definition openings" FontSize="20" Margin="0,18,0,12"/><StackPanel x:Name="RecentClicksPanel"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="A dictionary that stays on your machine" FontSize="23" Margin="0,0,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="AI word assistance" FontSize="19" Margin="0,0,0,10"/>
     <TextBlock Text="Check a definition or identify an unfamiliar word from Search. AI suggestions can be wrong; dictionary definitions stay separate. Requests run only when you press Ask AI." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
     <TextBlock Text="Provider"/><ComboBox x:Name="AiProviderPicker" SelectionChanged="AiProviderChanged" Margin="0,6,0,10"/>
     <TextBlock Text="Model"/><ComboBox x:Name="AiModelPicker" DisplayMemberPath="DisplayName" SelectionChanged="AiModelChanged" Margin="0,6,0,10"/>
     <Button x:Name="RefreshAiModelsButton" Content="Refresh models" Click="RefreshAiModelsClick" HorizontalAlignment="Left"/>
     <StackPanel x:Name="ChatGptConnectionPanel" Margin="0,12,0,0">
      <TextBlock Text="ChatGPT connection"/><ComboBox x:Name="ChatGptAccountPicker" DisplayMemberPath="Label" SelectionChanged="ChatGptAccountChanged" Margin="0,6,0,10"/>
      <WrapPanel><Button x:Name="ConnectChatGptButton" Content="Continue with ChatGPT" Click="ConnectChatGptClick"/><Button Content="Add another account" Click="AddChatGptAccountClick"/><Button Content="Sign out" Click="SignOutChatGptClick"/><Button Content="Manage ChatGPT usage" Click="ManageChatGptUsageClick"/><Button x:Name="CancelChatGptSignInButton" Content="Cancel sign-in" Click="CancelChatGptSignInClick" IsEnabled="False"/></WrapPanel>
     </StackPanel>
     <TextBlock x:Name="AiConnectionStatus" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"/>
     <TextBlock Text="ChatGPT sends the context and question shown in Search to OpenAI and uses your plan allowance. Ollama uses installed models at 127.0.0.1:11434; no models are downloaded and there is no automatic provider fallback. Off disables AI requests." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Offline resources" FontSize="19" Margin="0,0,0,10"/><TextBlock x:Name="ResourceInfo" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/><WrapPanel><Button x:Name="InstallButton" Content="Install offline resources" Click="InstallClick" Style="{StaticResource PrimaryButton}"/><Button Content="Check for resource updates" Click="CheckUpdatesClick"/></WrapPanel><TextBlock Text="Downloads: approximately 62 MiB. Install and indexing can take a minute. Cancel is available below. Reinstalling preserves personal entries and history." Foreground="{StaticResource MutedBrush}"/><Button x:Name="CancelInstallButton" Content="Cancel installation" Click="CancelClick" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kanji meanings from Anki" FontSize="19" Margin="0,0,0,10"/><TextBlock Text="Uses exact kanji cards from your local AnkiConnect service. Keep Anki open. The deck includes its child decks. No cards are changed." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Deck"/><TextBox x:Name="AnkiDeckInput"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Kanji field"/><TextBox x:Name="AnkiExpressionInput"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Meaning field"/><TextBox x:Name="AnkiMeaningInput"/></StackPanel></Grid><Button Content="Save Anki mapping / refresh" Click="SaveAnkiClick" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reading appearance" FontSize="19" Margin="0,0,0,10"/><TextBlock Text="Reading text size (passage, dictionary and results)"/><TextBlock x:Name="FontSizeLabel" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/><Slider x:Name="FontSlider" Minimum="16" Maximum="96" Value="24" TickFrequency="1.3333333333333" SmallChange="1.3333333333333" LargeChange="13.3333333333333" IsSnapToTickEnabled="True" Width="260" HorizontalAlignment="Left" ValueChanged="FontChanged"/><TextBlock Text="Grammar engine: Built-in · offline rules v1" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,6"/><TextBlock Text="Prototype coverage: しか～ない, という + noun, っていうのに, のでもなく / のではなく, なりに, ～ば, ～まい. Coverage is limited; no supported pattern does not mean there is no grammar. Local-model mode is not included in this build." Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dictionary terminology" FontSize="19" Margin="0,0,0,8"/><TextBlock Text="A guide to the short grammar and vocabulary labels in results." Foreground="{StaticResource MutedBrush}"/><StackPanel x:Name="TerminologyPanel"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your data" FontSize="19" Margin="0,0,0,10"/><TextBlock x:Name="DataInfo" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/><WrapPanel><Button Content="Create backup…" Click="BackupClick"/><Button Content="Restore backup…" Click="RestoreClick"/><Button Content="Clear all history…" Click="ClearHistoryClick"/></WrapPanel><TextBlock Text="Backups contain personal entries, settings, searches, and clicks. Replaceable dictionaries are omitted. Restore replaces personal data and first saves a safety backup. Older backup files remain independent copies." Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sources &amp; notices" FontSize="19" Margin="0,0,0,10"/><TextBlock Text="JMdict © EDRDG, via jmdict-simplified. OpenJLPT contributors, derived from Jonathan Waller's lists and JMdict. Reference data: CC BY-SA 4.0. JLPT labels are community estimates; no label does not imply advanced vocabulary. Common and N5–N1 identities use the pinned Anki Stats baseline." Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Morphology: NMeCab 0.10.2 (LGPL 2.1), UniDic-lite 1.0.8 / UniDic 2.1.2 (BSD). Project-authored grammar cards. See the included LICENSES folder and THIRD-PARTY-NOTICES.md for full texts and source links." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="2" Text="Ready · Offline by design" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" FontSize="12"/>
 </Grid>
</Window>
